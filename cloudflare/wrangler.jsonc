{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallet-vitals",
  "main": "src/main.py",
  "account_id": "aa910b06f5309291294256e9c98774fe",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "routes": [
    {"pattern": "onebattle.win/wallet-vitals", "zone_name": "onebattle.win"},
    {"pattern": "onebattle.win/wallet-vitals/*", "zone_name": "onebattle.win"}
  ],
  "d1_databases": [{"binding": "DB", "database_name": "wallet-vitals-reports", "database_id": "e6bf0550-caef-45ae-8cc3-29cdd558b60f"}],
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {
    "PUBLIC_BASE_PATH": "/wallet-vitals",
    "GRAPH_SUBGRAPH_ID": "Cd2gEDVeqnjBn1hSeqFMitw8Q1iiyV9FYUZkLNRcL87g",
    "ETHEREUM_RPC_URL": "https://eth.drpc.org",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "DAILY_REQUEST_LIMIT": "100"
  },
  "observability": {"enabled": false}
}
